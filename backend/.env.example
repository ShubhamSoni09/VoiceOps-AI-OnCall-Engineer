# VoiceOps — copy to .env and fill in as needed

# STT: whisper (local) | aws
STT_PROVIDER=whisper
WHISPER_MODEL=tiny

# LLM: openai | mock (local) | bedrock
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TTS: openai | mock (browser speech fallback on the UI)
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=shimmer
# Set true to use OpenAI TTS on voice requests (slower; UI can speak in-browser when false)
TTS_ON_VOICE=false

# AWS (when using aws STT)
AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket

# Memory
CONTEXT_WINDOW_TURNS=10
MEMORY_STORE_PATH=.voiceops_memory.json

# Auth
JWT_SECRET=change-me-in-production-voiceops

# MCP workspace — set to connect dashboard + MCP tools to a repo (e.g. sandbox or /path/to/your/repo)
# Leave empty for a disconnected / empty console on first load
# VOICEOPS_WORKSPACE=sandbox

DEBUG=false

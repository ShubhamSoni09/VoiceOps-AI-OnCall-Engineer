# VoiceOps — copy to .env and fill in as needed

# STT: whisper (local) | aws
STT_PROVIDER=whisper
WHISPER_MODEL=tiny

# LLM: openai | mock (local) | bedrock
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TTS: openai | mock (browser speech fallback on the UI)
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=shimmer
TTS_ON_VOICE=false

# AWS (when using aws STT)
AWS_REGION=us-east-1

# Memory / persistence
CONTEXT_WINDOW_TURNS=10
MEMORY_STORE_PATH=.voiceops_memory.json
# On Render, mount a disk at /data and set:
# DATA_DIR=/data

# Auth
JWT_SECRET=change-me-in-production-voiceops

# Public URL (OAuth redirects) — e.g. https://voiceops.onrender.com
APP_PUBLIC_URL=http://127.0.0.1:8001

# MCP workspace — local path or /data/workspace on Render
# VOICEOPS_WORKSPACE=sandbox

# GitHub — clone target repo on the server + open PRs after fixes
# GITHUB_REPO=your-org/your-service
# GITHUB_DEPLOY_TOKEN=ghp_...   # PAT with repo scope (server clone)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://127.0.0.1:8001/auth/github/callback
# GITHUB_AUTO_PR=true

DEBUG=false

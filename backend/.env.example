# VoiceOps — copy to .env and fill in as needed

# STT: whisper (local) | aws
STT_PROVIDER=whisper
WHISPER_MODEL=tiny

# LLM runtime: openai | anthropic | openai_compatible | mock (local deterministic) | bedrock
# The model only provides reasoning. VoiceOps still owns memory, planning, tools, approvals, and audit.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_MODEL=glm-5.2
LLM_CONNECTION_STORE_PATH=backend/data/llm_connections.json
AGENT_LLM_ROUTES_PATH=backend/data/agent_llm_routes.json

# TTS: openai | mock (browser speech fallback on the UI)
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=shimmer
# Set true to use OpenAI TTS on voice requests (slower; UI can speak in-browser when false)
TTS_ON_VOICE=false

# AWS (when using aws STT)
AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket

# Memory
CONTEXT_WINDOW_TURNS=10
MEMORY_STORE_PATH=.voiceops_memory.json

# External coding agents: claude | codex | cursor | local
EXTERNAL_AGENT_ALLOWED_PROVIDERS=claude,codex,cursor,local
EXTERNAL_AGENT_STORE_PATH=data/external_agent_credentials.json
# Set this in production; defaults to JWT_SECRET locally.
# EXTERNAL_AGENT_CREDENTIAL_SECRET=replace-with-64-hex-character-secret
EXTERNAL_AGENT_OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8001
# Local demos can use mock OAuth. Production must set this false and configure real provider OAuth.
EXTERNAL_AGENT_OAUTH_MOCK_ENABLED=true
# Configure only when the provider exposes a supported OAuth app for your account/plan.
# CLAUDE_OAUTH_CLIENT_ID=
# CLAUDE_OAUTH_CLIENT_SECRET=
# CLAUDE_OAUTH_TOKEN_URL=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_TOKEN_URL=
# CURSOR_OAUTH_CLIENT_ID=
# CURSOR_OAUTH_CLIENT_SECRET=
# CURSOR_OAUTH_TOKEN_URL=

# Auth
JWT_SECRET=change-me-in-production-voiceops
# Local demo seed users are convenient for development. Production template disables this.
SEED_DEMO_USERS=true
PRODUCTION_STARTUP_SECURITY_GATE=true

# Runtime stores
# Local JSON remains convenient for demos. Use the dry-run migration before switching to SQLite:
#   python scripts/migrate_collab_json_to_sqlite.py --dry-run --report-json
#   python scripts/migrate_collab_json_to_sqlite.py --report-json
# Production should use COLLAB_STORE_BACKEND=sqlite.
COLLAB_STORE_BACKEND=json
COLLAB_STORE_PATH=data/collaboration.json
COLLAB_SQLITE_PATH=data/collaboration.sqlite3

# MCP workspace — set to connect dashboard + MCP tools to a repo (e.g. sandbox or /path/to/your/repo)
# Leave empty for a disconnected / empty console on first load
# VOICEOPS_WORKSPACE=sandbox
# If VOICEOPS_WORKSPACE is empty, the admin UI can remember one local selection here.
WORKSPACE_SELECTION_PATH=data/workspace_selection.json
# GitHub clone UI uses this when no explicit target path is provided.
WORKSPACE_CLONE_ROOT=~/.voiceops/workspaces

DEBUG=false

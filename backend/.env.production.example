# VoiceOps production trial environment template.
# Copy to backend/.env on the host running FastAPI, then replace every placeholder.
# Do not commit a filled .env file.

# Environment and network boundary
DEPLOYMENT_ENVIRONMENT=production
DEBUG=false
CORS_ALLOWED_ORIGINS=https://voiceops.example.com
CORS_ALLOW_CREDENTIALS=true

# Private runtime data. Keep this outside VOICEOPS_WORKSPACE and out of git.
VOICEOPS_RUNTIME_DIR=/var/lib/voiceops

# Auth and accounts
# Use a generated 32+ character secret, for example: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-character-secret
JWT_EXPIRE_MINUTES=720
USERS_STORE_PATH=/var/lib/voiceops/users.json
SEED_DEMO_USERS=false
PRODUCTION_STARTUP_SECURITY_GATE=true

# Runtime stores. Production trial uses SQLite for durable room/audit state.
COLLAB_STORE_BACKEND=sqlite
COLLAB_SQLITE_PATH=/var/lib/voiceops/collaboration.sqlite3
SPEAKER_STORE_BACKEND=sqlite
SPEAKER_SQLITE_PATH=/var/lib/voiceops/speakers.sqlite3
AGENT_RUNS_PATH=/var/lib/voiceops/agent_runs.json
AGENT_LLM_ROUTES_PATH=/var/lib/voiceops/agent_llm_routes.json
LONG_MEMORY_PATH=/var/lib/voiceops/long_memory.json
RAG_INDEX_PATH=/var/lib/voiceops/rag_index.json
LLM_CONNECTION_STORE_PATH=/var/lib/voiceops/llm_connections.json
EXTERNAL_AGENT_STORE_PATH=/var/lib/voiceops/external_agent_credentials.json
DEMO_EVIDENCE_PATH=/var/lib/voiceops/demo_evidence.json

# Workspace boundary. Set this to the exact repo root the team will edit.
VOICEOPS_WORKSPACE=/absolute/path/to/team/repository

# Speech, speaker attribution, and live meeting.
STT_PROVIDER=mock
SPEAKER_PROVIDER=whisperx
HF_TOKEN=replace-with-huggingface-token-with-pyannote-access
WHISPERX_MODEL=small
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_WORKER_MODE=persistent_subprocess
LIVE_CHUNK_SECONDS=2
LIVE_WINDOW_SECONDS=8
LIVE_SESSION_IDLE_TTL_SECONDS=1800
LIVE_PROCESSING_TIMEOUT_SECONDS=8
WHISPERX_WORKER_TIMEOUT_SECONDS=90
SPEAKER_VERIFICATION_TIMEOUT_SECONDS=300

# AI teammate identity and providers.
AGENT_DISPLAY_NAME=VoiceOps
AGENT_INITIALS=VO
AGENT_WAKE_WORDS=voiceops,voice ops,assistant,agent
# LLM runtime is the user/team-provided reasoning backend. VoiceOps keeps action approval and audit control.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_MODEL=glm-5.2
TTS_PROVIDER=mock
TTS_ON_VOICE=false

# External coding agent providers.
# Use official OAuth/API keys/local CLI auth only; never collect provider passwords or browser cookies.
EXTERNAL_AGENT_ALLOWED_PROVIDERS=claude,codex,cursor,local
EXTERNAL_AGENT_CREDENTIAL_SECRET=replace-with-64-hex-character-secret
EXTERNAL_AGENT_OAUTH_REDIRECT_BASE_URL=https://voiceops.example.com
EXTERNAL_AGENT_OAUTH_MOCK_ENABLED=false
# Fill these only after creating official provider OAuth apps and confirming scopes.
# CLAUDE_OAUTH_CLIENT_ID=
# CLAUDE_OAUTH_CLIENT_SECRET=
# CLAUDE_OAUTH_TOKEN_URL=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_TOKEN_URL=
# CURSOR_OAUTH_CLIENT_ID=
# CURSOR_OAUTH_CLIENT_SECRET=
# CURSOR_OAUTH_TOKEN_URL=

# Optional GitHub PR creation. Keep disabled until the local branch workflow is stable.
GITHUB_PR_CREATION_ENABLED=false
GITHUB_PR_CLI_PATH=gh
GITHUB_PR_ALLOWED_BASE_BRANCHES=main
GITHUB_PR_COMMAND_TIMEOUT_SECONDS=60
GITHUB_PR_CREATE_DRAFT=true
